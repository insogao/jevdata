  {
   "type": "message",
   "time": "9月11日 09:43",
   "speaker": "B",
   "text": "最近路口在修人行道。"
  },
  {
   "type": "message",
   "time": "9月11日 09:44",
   "speaker": "A",
   "text": "难怪车都排到桥上了。"
