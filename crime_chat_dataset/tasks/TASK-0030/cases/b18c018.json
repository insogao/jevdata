{
  "key": "b18c018",
  "archetype_id": "ARC-000101",
  "subtype": "help_move_fund_fee",
  "latent_intent": "熟人以当天往返的跑腿名义请对方携带身份证代取一笔来源不明的现金，并承诺按比例付酬；对方追问款项性质后拒绝。",
  "critical_facts": [
    "对方被要求带身份证当天往返",
    "报酬按取出金额的千分之五计算",
    "款项来源和用途未说明",
    "对方拒绝参与并要求走正规平台"
  ],
  "benign_alternatives": [
    "帮忙取快递",
    "兼职跑腿平台"
  ],
  "events": [
    {
      "type": "message",
      "time": "8月7日 09:07",
      "speaker": "A",
      "text": "明天能不能帮我跑一趟，来回当天就够"
    },
    {
      "type": "message",
      "time": "8月7日 09:14",
      "speaker": "A",
      "text": "带好身份证，到时候有人交接"
    },
    {
      "type": "message",
      "time": "8月7日 09:21",
      "speaker": "A",
      "text": "先把东西拿到手，回来给你千分之五"
    },
    {
      "type": "message",
      "time": "8月7日 09:28",
      "speaker": "A",
      "text": "别问那么细，就熟人临时周转"
    },
    {
      "type": "message",
      "time": "8月7日 09:35",
      "speaker": "A",
      "text": "你下午过去，晚上回来，不耽误事"
    },
    {
      "type": "message",
      "time": "8月7日 09:42",
      "speaker": "A",
      "text": "我给你报销车费，再加跑腿钱"
    },
    {
      "type": "message",
      "time": "8月7日 09:49",
      "speaker": "A",
      "text": "没有平台，咱俩认识这么久了"
    },
    {
      "type": "message",
      "time": "8月7日 09:56",
      "speaker": "A",
      "text": "那就算我欠你个人情"
    },
    {
      "type": "message",
      "time": "8月7日 10:03",
      "speaker": "A",
      "text": "你别跟别人说我问过你"
    },
    {
      "type": "message",
      "time": "8月7日 10:10",
      "speaker": "A",
      "text": "午饭吃了吗"
    },
    {
      "type": "message",
      "time": "8月7日 10:17",
      "speaker": "B",
      "text": "刚吃了楼下的面，今天人好多"
    },
    {
      "type": "message",
      "time": "8月7日 10:24",
      "speaker": "A",
      "text": "我带了饭，结果忘记拿筷子"
    },
    {
      "type": "message",
      "time": "8月7日 10:31",
      "speaker": "B",
      "text": "哈哈去前台借一双呗"
    },
    {
      "type": "message",
      "time": "8月7日 10:38",
      "speaker": "A",
      "text": "我刚看到消息，上午一直在开会"
    },
    {
      "type": "message",
      "time": "8月7日 10:45",
      "speaker": "B",
      "text": "没事，我也忙到现在"
    },
    {
      "type": "message",
      "time": "8月8日 09:07",
      "speaker": "B",
      "text": "取什么东西"
    },
    {
      "type": "message",
      "time": "8月8日 09:14",
      "speaker": "B",
      "text": "身份证为什么要带，具体是什么"
    },
    {
      "type": "message",
      "time": "8月8日 09:21",
      "speaker": "B",
      "text": "你说的是按金额算？那更得先讲清楚"
    },
    {
      "type": "message",
      "time": "8月8日 09:28",
      "speaker": "B",
      "text": "谁的钱，为什么让我拿"
    },
    {
      "type": "message",
      "time": "8月8日 09:35",
      "speaker": "B",
      "text": "我不接来源不明的现金"
    },
    {
      "type": "message",
      "time": "8月8日 09:42",
      "speaker": "B",
      "text": "这不是普通取快递，平台订单呢"
