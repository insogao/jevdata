{
  "key": "b18c009",
  "archetype_id": "ARC-000087",
  "subtype": "exam_score_lookup",
  "latent_intent": "学校工作人员因私人红包，暗示可进入教师端查看并发送学生成绩截图；家长中间人并非监护人，仍试图索取他人成绩，工作人员最后拒绝。",
  "critical_facts": [
    "请求查看非本人监护学生的成绩",
    "工作人员被要求在班主任系统中查看",
    "已发送红包",
    "索要截图并被拒绝或要求走官方授权渠道"
  ],
  "benign_alternatives": [
    "家长查自己孩子",
    "学校官方查询"
  ],
  "events": [
    {
      "type": "message",
      "time": "8月7日 09:07",
      "speaker": "A",
      "text": "上次说的那个成绩，能不能帮忙看一下"
    },
    {
      "type": "message",
      "time": "8月7日 09:14",
      "speaker": "A",
      "text": "不是我家孩子，家里人托我问问"
    },
    {
      "type": "message",
      "time": "8月7日 09:21",
      "speaker": "A",
      "text": "红包已经发了，就点一下班主任系统看看"
    },
    {
      "type": "message",
      "time": "8月7日 09:28",
      "speaker": "A",
      "text": "我就想知道大概分数，截图就行"
    },
    {
      "type": "message",
      "time": "8月7日 09:35",
      "speaker": "A",
      "text": "名字我都给你了，帮个忙嘛"
    },
    {
      "type": "message",
      "time": "8月7日 09:42",
      "speaker": "A",
      "text": "家长端好像还没更新"
    },
    {
      "type": "message",
      "time": "8月7日 09:49",
      "speaker": "A",
      "text": "真不能通融一下？"
    },
    {
      "type": "message",
      "time": "8月7日 09:56",
      "speaker": "A",
      "text": "那我怎么跟家里人交代"
    },
    {
      "type": "message",
      "time": "8月7日 10:03",
      "speaker": "A",
      "text": "行，你退吧"
    },
    {
      "type": "message",
      "time": "8月7日 10:10",
      "speaker": "A",
      "text": "午饭吃了吗"
    },
    {
      "type": "message",
      "time": "8月7日 10:17",
      "speaker": "B",
      "text": "刚吃了楼下的面，今天人好多"
    },
    {
      "type": "message",
      "time": "8月7日 10:24",
      "speaker": "A",
      "text": "我带了饭，结果忘记拿筷子"
    },
    {
      "type": "message",
      "time": "8月7日 10:31",
      "speaker": "B",
      "text": "哈哈去前台借一双呗"
    },
    {
      "type": "message",
      "time": "8月7日 10:38",
      "speaker": "A",
      "text": "我刚看到消息，上午一直在开会"
    },
    {
      "type": "message",
      "time": "8月7日 10:45",
      "speaker": "B",
      "text": "没事，我也忙到现在"
    },
    {
      "type": "message",
      "time": "8月8日 09:07",
      "speaker": "B",
      "text": "你是孩子监护人吗，应该走家长端"
    },
    {
      "type": "message",
      "time": "8月8日 09:14",
      "speaker": "B",
      "text": "那我不能从老师系统里查"
    },
    {
      "type": "message",
      "time": "8月8日 09:21",
      "speaker": "B",
      "text": "红包我退给你，权限不能这样用"
    },
    {
      "type": "message",
      "time": "8月8日 09:28",
      "speaker": "B",
      "text": "成绩是学生隐私，没有授权不能发截图"
    },
    {
      "type": "message",
      "time": "8月8日 09:35",
      "speaker": "B",
      "text": "知道名字也不代表有权查看"
    },
    {
      "type": "message",
      "time": "8月8日 09:42",
      "speaker": "B",
      "text": "让监护人联系学校官方渠道"
    },
    {
      "type": "message",
      "time": "8月8日 09:49",
      "speaker": "B",
      "text": "不能，我会把红包退回并按流程处理"
    },
    {
      "type": "message",
      "time": "8月8日 09:56",
      "speaker": "B",
      "text": "让他们本人申请查询比较合适"
    },
    {
      "type": "message",
      "time": "8月8日 10:03",
      "speaker": "B",
      "text": "已经原路退回了，请别再发这类请求"
    },
    {
      "type": "message",
      "time": "8月8日 10:10",
      "speaker": "A",
      "text": "这两天一直下雨"
    },
    {
      "type": "message",
      "time": "8月8日 10:17",
      "speaker": "B",
      "text": "我早上没带伞，鞋都湿了"
    },
    {
      "type": "message",
      "time": "8月8日 10:24",
      "speaker": "A",
      "text": "我车里有把折叠伞，下次拿给你"
    },
    {
      "type": "message",
      "time": "8月8日 10:31",
      "speaker": "B",
      "text": "好啊，天气预报说周末转晴"
    },
    {
      "type": "transfer",
      "time": "8月8日 10:38",
      "from": "A",
      "to": "B",
      "amount": 200,
      "status": "received"
    },
