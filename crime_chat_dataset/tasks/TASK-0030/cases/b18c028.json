{
  "key": "b18c028",
  "archetype_id": "ARC-000104",
  "subtype": "charity_receipt_wash",
  "latent_intent": "商务联系人提出一笔大额公益捐赠后返还大部分款项，却要求开具全额票据并强调对公支付；对方拒绝虚开发票和返款安排。",
  "critical_facts": [
    "提出十万元捐赠并返还八万五",
    "要求按全额开具票据",
    "强调对公转账以显得规范",
    "对方说明票据须与真实捐赠一致并拒绝"
  ],
  "benign_alternatives": [
    "合法公益捐赠抵税",
    "基金会募捐"
  ],
  "events": [
    {
      "type": "message",
      "time": "6月8日 09:07",
      "speaker": "A",
      "text": "我们准备支持你们项目，金额十万"
    },
    {
      "type": "message",
      "time": "6月8日 09:14",
      "speaker": "A",
      "text": "到账之后能不能返八万五，剩下算合作费"
    },
    {
      "type": "message",
      "time": "6月8日 09:21",
      "speaker": "A",
      "text": "票据还是按十万全额开，走对公好看"
    },
    {
      "type": "message",
      "time": "6月8日 09:28",
      "speaker": "A",
      "text": "这只是双方内部结算，不影响项目"
    },
    {
      "type": "message",
      "time": "6月8日 09:35",
      "speaker": "A",
      "text": "其他机构也能这么处理"
    },
    {
      "type": "message",
      "time": "6月8日 09:42",
      "speaker": "A",
      "text": "先开票，细节后面再说"
    },
    {
      "type": "message",
      "time": "6月8日 09:49",
      "speaker": "A",
      "text": "那就先按全额打过去"
    },
    {
      "type": "message",
      "time": "6月8日 09:56",
      "speaker": "A",
      "text": "你们不是缺资金吗"
    },
    {
      "type": "message",
      "time": "6月8日 10:03",
      "speaker": "A",
      "text": "我再找别家问问"
    },
    {
      "type": "message",
      "time": "6月8日 10:10",
      "speaker": "A",
      "text": "这两天一直下雨"
    },
    {
      "type": "message",
      "time": "6月8日 10:17",
      "speaker": "B",
      "text": "我早上没带伞，鞋都湿了"
    },
    {
      "type": "message",
      "time": "6月8日 10:24",
      "speaker": "A",
      "text": "我车里有把折叠伞，下次拿给你"
    },
    {
      "type": "message",
      "time": "6月8日 10:31",
      "speaker": "B",
      "text": "好啊，天气预报说周末转晴"
    },
    {
      "type": "message",
      "time": "6月8日 10:38",
      "speaker": "A",
      "text": "我刚看到消息，上午一直在开会"
    },
    {
      "type": "message",
      "time": "6月8日 10:45",
      "speaker": "B",
      "text": "没事，我也忙到现在"
    },
    {
      "type": "message",
      "time": "6月9日 09:07",
      "speaker": "B",
      "text": "感谢支持，按实际到账开具捐赠凭证"
    },
    {
      "type": "message",
      "time": "6月9日 09:14",
      "speaker": "B",
      "text": "捐赠款不能约定返还"
    },
    {
      "type": "message",
      "time": "6月9日 09:21",
      "speaker": "B",
      "text": "凭证必须对应真实的捐赠金额和用途"
    },
    {
      "type": "message",
      "time": "6月9日 09:28",
      "speaker": "B",
      "text": "返款安排会改变捐赠性质，我不能同意"
    },
    {
      "type": "message",
      "time": "6月9日 09:35",
      "speaker": "B",
      "text": "请提供合规的捐赠协议和资金用途"
    },
    {
      "type": "message",
      "time": "6月9日 09:42",
      "speaker": "B",
      "text": "必须先完成合规审核，不会预开发票"
    },
    {
      "type": "message",
      "time": "6月9日 09:49",
      "speaker": "B",
      "text": "有返款条件就不能当作捐赠接收"
    },
    {
      "type": "message",
      "time": "6月9日 09:56",
      "speaker": "B",
      "text": "我们会按公开流程募捐，不做不实记录"
    },
    {
      "type": "message",
      "time": "6月9日 10:03",
      "speaker": "B",
      "text": "可以，建议让财务和法务核实方案"
    },
    {
      "type": "message",
      "time": "6月9日 10:10",
      "speaker": "A",
      "text": "你家猫最近还挑食吗"
    },
    {
      "type": "message",
      "time": "6月9日 10:17",
      "speaker": "B",
      "text": "好多了，换了个口味就肯吃"
    },
    {
      "type": "message",
      "time": "6月9日 10:24",
      "speaker": "A",
      "text": "我家那只只认一个牌子，难伺候"
    },
    {
      "type": "message",
      "time": "6月9日 10:31",
      "speaker": "B",
      "text": "猫都这样，自己像个老板"
    },
    {
      "type": "message",
      "time": "6月9日 10:38",
      "speaker": "A",
      "text": "我刚看到消息，上午一直在开会"
    },
    {
      "type": "message",
      "time": "6月9日 10:45",
      "speaker": "B",
      "text": "没事，我也忙到现在"
    },
    {
      "type": "transfer",
      "time": "6月9日 10:52",
      "from": "A",
      "to": "B",
      "amount": 100000,
      "status": "received"
    },
    {
      "type": "message",
      "time": "6月9日 10:52",
      "speaker": "A",
      "text": "你那边今天还顺利吗"
    },
    {
      "type": "message",
      "time": "6月9日 10:59",
      "speaker": "B",
      "text": "还行，就是事情有点杂"
    },
    {
      "type": "message",
      "time": "6月9日 11:06",
      "speaker": "A",
      "text": "那先忙你的，晚点再说"
    },
    {
      "type": "message",
      "time": "6月9日 11:13",
      "speaker": "B",
      "text": "好，回头联系"
    },
    {
      "type": "message",
      "time": "6月9日 11:20",
      "speaker": "A",
      "text": "对了，最近睡得怎么样"
    },
    {
