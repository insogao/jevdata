  {
   "type": "message",
   "time": "9月24日 10:10",
   "speaker": "B",
   "text": "今天跳水式降温"
  },
  {
   "type": "message",
   "time": "9月24日 10:12",
   "speaker": "A",
   "text": "秋裤已经安排上了"
  },
  {
   "type": "message",
   "time": "9月24日 10:13",
   "speaker": "B",
   "text": "明天还更低，别感冒耽误周六的事"
