  {
   "type": "message",
   "time": "9月24日 15:22",
   "speaker": "B",
   "text": "全现金，五千五当面点"
  },
  {
   "type": "message",
   "time": "9月24日 15:23",
   "speaker": "A",
   "text": "老规矩，验完货当面点清"
