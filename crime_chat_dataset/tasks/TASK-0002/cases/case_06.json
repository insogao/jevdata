{
 "key": "case_06",
 "archetype_id": "ARC-000149",
 "subtype": "informal_loan_ads_network",
 "latent_intent": "头目组织张贴员夜间成片张贴带可变二维码的贷款小广告，按栋计酬、日结现金并设撕毁罚则，属非正规放贷广告网络的地面推广环节。",
 "critical_facts": [
  "A 派 B 夜间作业，要求一夜贴完一个区（城东），纸张工具由 A 统一提供并要求粘得死",
  "报酬按栋结钱，一栋十五元现金当晚结算，且要求贴上去一个月撕不下来",
  "存在罚则撕了扣钱：被保安撕掉的算不可抗，自己贴的掉了才扣",
  "所贴纸张印有急用钱大字和二维码，二维码捂熟了就换新的，属违规小广告引流"
 ],
 "benign_alternatives": [
  "正规广告投放",
  "社区通知张贴"
 ],
 "events": [
  {
   "type": "message",
   "time": "10月12日 22:10",
   "speaker": "A",
   "text": "小海，出来没"
  },
  {
   "type": "message",
   "time": "10月12日 22:13",
   "speaker": "B",
   "text": "到路上了，电动车二十分钟"
  },
  {
   "type": "message",
   "time": "10月12日 22:14",
   "speaker": "A",
   "text": "别赶，慢点骑"
  },
  {
   "type": "message",
   "time": "10月12日 22:15",
   "speaker": "B",
   "text": "知道，头盔戴着呢"
  },
  {
   "type": "message",
   "time": "10月12日 22:20",
   "speaker": "B",
   "text": "强哥，今晚哪片"
  },
  {
   "type": "message",
   "time": "10月12日 22:22",
   "speaker": "A",
   "text": "城东，火车站往东，一夜贴完一个区"
  },
  {
   "type": "message",
   "time": "10月12日 22:24",
   "speaker": "B",
   "text": "一个区？上回城西才半个"
  },
  {
   "type": "message",
   "time": "10月12日 22:26",
   "speaker": "A",
   "text": "这边钱多，纸我都给你备好了"
  },
  {
   "type": "message",
   "time": "10月12日 22:28",
   "speaker": "B",
   "text": "浆糊还是胶"
  },
  {
   "type": "message",
   "time": "10月12日 22:30",
   "speaker": "A",
   "text": "胶，新买的，粘得死"
  },
  {
   "type": "message",
   "time": "10月12日 22:32",
   "speaker": "B",
   "text": "粘得死，物业撕不得骂街"
  },
  {
   "type": "message",
   "time": "10月12日 22:34",
   "speaker": "A",
   "text": "就要它撕不下来，贴上就是一个月"
  },
  {
   "type": "message",
   "time": "10月12日 22:50",
   "speaker": "B",
   "text": "完事你请我撸串不"
  },
  {
   "type": "message",
   "time": "10月12日 22:52",
   "speaker": "A",
   "text": "请，老地方，二十串起步"
  },
  {
   "type": "message",
   "time": "10月12日 22:54",
   "speaker": "B",
   "text": "加个烤茄子"
  },
  {
   "type": "message",
   "time": "10月12日 22:56",
   "speaker": "A",
   "text": "干完想吃啥都行"
  },
  {
   "type": "message",
   "time": "10月13日 09:30",
   "speaker": "A",
   "text": "昨晚干了几个栋"
  },
  {
   "type": "message",
   "time": "10月13日 09:33",
   "speaker": "B",
   "text": "三十二个，都有数的"
  },
  {
   "type": "message",
   "time": "10月13日 09:35",
   "speaker": "A",
   "text": "行，按栋结，一栋十五，晚上现金"
  },
  {
   "type": "message",
   "time": "10月13日 09:37",
   "speaker": "B",
   "text": "十五？城西那回十八"
  },
  {
   "type": "message",
   "time": "10月13日 09:40",
   "speaker": "A",
   "text": "城西有楼道，城东全是大门，省胶"
  },
  {
   "type": "message",
   "time": "10月13日 09:42",
   "speaker": "B",
   "text": "行吧，你可真精"
  },
  {
   "type": "message",
   "time": "10月13日 11:20",
   "speaker": "B",
   "text": "哥，我房东又要涨房租"
  },
  {
   "type": "message",
   "time": "10月13日 11:23",
   "speaker": "A",
   "text": "涨多少"
  },
  {
   "type": "message",
   "time": "10月13日 11:24",
   "speaker": "B",
   "text": "一百，说周边都涨了"
  },
  {
   "type": "message",
   "time": "10月13日 11:26",
   "speaker": "A",
   "text": "那不如搬我这边，老小区便宜"
  },
  {
   "type": "message",
   "time": "10月14日 19:10",
   "speaker": "A",
   "text": "今晚有雨，带雨衣"
  },
  {
   "type": "message",
   "time": "10月14日 19:14",
   "speaker": "B",
   "text": "看了，小雨，没事"
  },
  {
   "type": "message",
   "time": "10月14日 19:16",
   "speaker": "A",
   "text": "小雨纸全黏背上，废"
  },
  {
   "type": "message",
   "time": "10月14日 19:18",
   "speaker": "B",
   "text": "那我带块塑料布垫着"
  },
  {
   "type": "message",
   "time": "10月14日 23:05",
   "speaker": "B",
   "text": "哥，出事了，保安追了我两条街"
  },
  {
   "type": "message",
   "time": "10月14日 23:08",
   "speaker": "A",
   "text": "人没事吧"
  },
  {
   "type": "message",
   "time": "10月14日 23:09",
   "speaker": "B",
   "text": "没事，甩掉了"
  },
  {
   "type": "message",
   "time": "10月14日 23:11",
   "speaker": "A",
   "text": "纸呢"
  },
  {
   "type": "message",
   "time": "10月14日 23:12",
   "speaker": "B",
   "text": "贴出去二十多栋，剩下半包丢了"
  },
  {
   "type": "message",
   "time": "10月14日 23:14",
   "speaker": "A",
   "text": "丢就丢了，人没事就行"
  },
  {
   "type": "message",
   "time": "10月14日 23:16",
   "speaker": "B",
   "text": "那今晚这算谁的，你那撕了扣钱的规矩……"
  },
  {
   "type": "message",
   "time": "10月14日 23:18",
   "speaker": "A",
   "text": "保安撕的算不可抗，自己贴的掉了我才扣，明晚补上就行"
  },
  {
   "type": "message",
   "time": "10月15日 21:30",
   "speaker": "B",
   "text": "哥，昨晚补的都贴完了"
  },
  {
   "type": "message",
   "time": "10月15日 21:33",
   "speaker": "A",
   "text": "数了，没少，行"
  },
  {
   "type": "message",
   "time": "10月15日 21:35",
   "speaker": "A",
   "text": "钱备好了，老地方点"
  },
  {
   "type": "message",
   "time": "10月15日 21:36",
   "speaker": "B",
   "text": "嗯，下片哪"
  },
  {
   "type": "message",
   "time": "10月15日 21:38",
   "speaker": "A",
   "text": "城北，三天后，这回量更大"
  },
  {
   "type": "message",
   "time": "10月15日 21:40",
   "speaker": "B",
   "text": "量更大，纸钱谁出"
  },
  {
   "type": "message",
   "time": "10月15日 22:10",
   "speaker": "B",
   "text": "对了，我妈给我安排了个相亲"
  },
  {
   "type": "message",
   "time": "10月15日 22:13",
   "speaker": "A",
   "text": "好事啊，啥条件"
  },
  {
   "type": "message",
   "time": "10月15日 22:15",
   "speaker": "B",
   "text": "幼儿园老师，照片看着凶"
  },
  {
   "type": "message",
   "time": "10月15日 22:17",
   "speaker": "A",
   "text": "凶点管得住你"
  },
  {
   "type": "message",
   "time": "10月15日 22:19",
   "speaker": "B",
   "text": "哈哈也是，确实需要"
  },
  {
   "type": "message",
   "time": "10月15日 22:21",
   "speaker": "A",
   "text": "周日去，穿件不带胶味的衣服"
  },
  {
   "type": "message",
   "time": "10月16日 20:15",
   "speaker": "B",
   "text": "哥，我车电池不行了，爬坡没劲"
  },
  {
   "type": "message",
   "time": "10月16日 20:18",
   "speaker": "A",
   "text": "换个电池，干完城北这票就回来了"
  },
  {
   "type": "message",
   "time": "10月16日 20:20",
   "speaker": "B",
   "text": "换电池小一千呢"
  },
  {
   "type": "message",
   "time": "10月16日 20:22",
   "speaker": "A",
   "text": "所以说这票干完就有了"
  },
  {
   "type": "message",
   "time": "10月16日 20:24",
   "speaker": "B",
   "text": "新纸印好没"
  },
  {
   "type": "message",
   "time": "10月16日 20:26",
   "speaker": "A",
   "text": "印好了，急用钱仨字加大，底下照旧带码"
  },
  {
   "type": "message",
   "time": "10月16日 20:28",
   "speaker": "B",
   "text": "又换新码了"
  },
  {
   "type": "message",
   "time": "10月16日 20:30",
   "speaker": "A",
   "text": "旧码捂熟了，换新的"
  },
  {
   "type": "message",
   "time": "10月16日 20:32",
   "speaker": "A",
   "text": "撕了扣钱的老规矩你知道"
  },
  {
   "type": "message",
   "time": "10月16日 20:34",
   "speaker": "B",
   "text": "放心，我贴的比春联还正"
  }
 ],
 "_registered": {
  "case_id": "CASE-0000026",
