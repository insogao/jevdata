    {
      "type": "message",
      "time": "9月4日 10:00",
      "speaker": "B",
      "text": "昨天看还在，停车点没变。"
    },
    {
      "type": "message",
      "time": "9月4日 10:12",
      "speaker": "A",
      "text": "好，我明早骑过去。"
    },
    {
      "type": "message",
      "time": "9月4日 10:24",
      "speaker": "B",
      "text": "记得看下轮胎气够不够。"
    }
  ],
