    {
      "type": "message",
      "time": "9月3日 10:48",
      "speaker": "B",
      "text": "办公室空调有时挺冷。"
    },
    {
      "type": "message",
      "time": "9月3日 11:00",
      "speaker": "A",
      "text": "好，我先记在日历里。"
    },
    {
      "type": "message",
      "time": "9月3日 11:12",
      "speaker": "B",
      "text": "行，晚点我再看一下。"
    },
    {
      "type": "message",
      "time": "9月3日 11:24",
      "speaker": "A",
      "text": "嗯，回头再聊。"
