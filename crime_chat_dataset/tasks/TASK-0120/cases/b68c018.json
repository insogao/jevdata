   "type": "message",
   "time": "10月2日 10:17",
   "speaker": "B",
   "text": "先照原计划，有变再说。"
  },
  {
   "type": "message",
   "time": "10月2日 10:20",
   "speaker": "A",
   "text": "行，到时互相说一声。"
  },
  {
   "type": "message",
   "time": "10月2日 10:23",
   "speaker": "B",
   "text": "好呀。"
  },
  {
   "type": "message",
   "time": "10月2日 10:26",
   "speaker": "A",
   "text": "我把相关时间也记下来了。"
  },
  {
   "type": "message",
   "time": "10月2日 10:29",
   "speaker": "B",
   "text": "好，临时有调整再联系。"
  },
