{
 "key": "b27c010",
 "archetype_id": "ARC-000047",
 "subtype": "hired_standing_off",
 "latent_intent": "债主雇发小带几名兄弟到与欠款人的谈判现场站着施压，按天付酬，全程只要站着不说话，靠人数制造压迫感逼对方还钱。",
 "critical_facts": [
  "A 请 B 带几个兄弟到与老周谈账的现场",
  "明确只要站着别说话、不许动手",
  "报酬按天结算，一天一千，先转头一天",
  "到场后老周立字据答应月底先结五万"
 ],
 "benign_alternatives": [
  "活动安保兼职",
  "婚礼挡酒兄弟"
 ],
 "events": [
  {
   "type": "message",
   "time": "10月9日 10:00",
   "speaker": "A",
   "text": "老六，周末去不打球"
  },
  {
   "type": "message",
   "time": "10月9日 10:02",
   "speaker": "B",
   "text": "不去了，膝盖刚养好"
  },
  {
   "type": "message",
   "time": "10月9日 10:03",
   "speaker": "A",
   "text": "那你天天泡健身房干嘛"
  },
  {
   "type": "message",
   "time": "10月9日 10:03",
   "speaker": "B",
   "text": "教练让练腿，我懒得动"
  },
  {
   "type": "message",
   "time": "10月9日 10:05",
   "speaker": "A",
   "text": "有个事想请你帮个忙"
  },
  {
   "type": "message",
   "time": "10月9日 10:06",
   "speaker": "B",
   "text": "你说"
  },
  {
   "type": "message",
   "time": "10月9日 10:06",
   "speaker": "A",
   "text": "周四我跟人谈点账上的事"
  },
  {
   "type": "message",
   "time": "10月9日 10:07",
   "speaker": "B",
   "text": "谈账要人帮什么忙"
  },
  {
   "type": "message",
   "time": "10月9日 10:07",
   "speaker": "A",
   "text": "你带上你那几个兄弟，跟着去站一站就行"
  },
  {
   "type": "message",
   "time": "10月9日 10:08",
   "speaker": "B",
   "text": "站站？站多久"
  },
  {
   "type": "message",
   "time": "10月9日 10:08",
   "speaker": "A",
   "text": "上午一场，谈完就散"
  },
  {
   "type": "message",
   "time": "10月9日 10:09",
   "speaker": "B",
   "text": "要说话不"
  },
  {
   "type": "message",
   "time": "10月9日 10:09",
   "speaker": "A",
   "text": "不用，你们只要站着，别说话"
  },
  {
   "type": "message",
   "time": "10月9日 10:10",
   "speaker": "B",
   "text": "这啥场合，说得这么邪乎"
  },
  {
   "type": "message",
   "time": "10月9日 10:10",
   "speaker": "A",
   "text": "老周欠我十好几万，三年了，见面就哭穷"
  },
  {
   "type": "message",
   "time": "10月9日 10:11",
   "speaker": "B",
   "text": "那回酒局见过，软耳朵一个"
  },
  {
   "type": "message",
   "time": "10月9日 10:11",
   "speaker": "A",
   "text": "对，不见真章他不挪窝"
  },
  {
   "type": "message",
   "time": "10月9日 10:12",
   "speaker": "B",
   "text": "兄弟几个够不"
  },
  {
   "type": "message",
   "time": "10月9日 10:12",
   "speaker": "A",
   "text": "三个就够，站一排有样子"
  },
  {
   "type": "message",
   "time": "10月9日 10:13",
   "speaker": "B",
   "text": "行，我来安排"
  },
  {
   "type": "message",
   "time": "10月9日 10:15",
   "speaker": "B",
   "text": "前天我妈还念叨你，说你上回带的茶好"
  },
  {
   "type": "message",
   "time": "10月9日 10:15",
   "speaker": "A",
   "text": "回头我再弄两斤给阿姨寄过去"
  },
  {
   "type": "message",
   "time": "10月9日 10:16",
   "speaker": "B",
   "text": "她就好口浓的"
  },
  {
   "type": "message",
   "time": "10月9日 10:16",
   "speaker": "A",
   "text": "记着呢，浓香型"
  },
  {
   "type": "message",
   "time": "10月9日 10:17",
   "speaker": "B",
   "text": "行，她指定高兴"
  },
  {
   "type": "message",
   "time": "10月9日 15:20",
   "speaker": "A",
   "text": "报酬怎么算，你开个口"
  },
  {
   "type": "message",
   "time": "10月9日 15:21",
   "speaker": "B",
   "text": "熟人还谈钱"
  },
  {
   "type": "message",
   "time": "10月9日 15:21",
   "speaker": "A",
   "text": "亲兄弟明算账，兄弟们也得有车马费"
  },
  {
   "type": "message",
   "time": "10月9日 15:22",
   "speaker": "B",
   "text": "那按天结算，一天一千，兄弟们吃住我包"
  },
  {
   "type": "message",
   "time": "10月9日 15:22",
   "speaker": "A",
   "text": "行，就怕一天谈不完"
  },
  {
   "type": "message",
   "time": "10月9日 15:23",
   "speaker": "B",
   "text": "谈不完算两天，我人带到散场"
  },
  {
   "type": "message",
   "time": "10月9日 15:23",
   "speaker": "A",
   "text": "成，先转头一天的"
  },
  {
   "type": "message",
   "time": "10月9日 15:24",
   "speaker": "B",
   "text": "嗯，晚上我跟兄弟们说时间地点"
  },
  {
   "type": "message",
   "time": "10月9日 15:24",
   "speaker": "A",
   "text": "周四上午十点，城西茶楼二楼"
  },
  {
   "type": "transfer",
   "time": "10月9日 15:30",
   "from": "A",
   "to": "B",
   "amount": 1000
  },
  {
   "type": "message",
   "time": "10月9日 15:31",
   "speaker": "B",
   "text": "收到，够痛快"
  },
  {
   "type": "message",
   "time": "10月9日 21:00",
   "speaker": "B",
   "text": "楼下新开的烤鱼吃了没"
  },
  {
   "type": "message",
   "time": "10月9日 21:01",
   "speaker": "A",
   "text": "还没，听说要排号"
  },
  {
   "type": "message",
   "time": "10月9日 21:01",
   "speaker": "B",
   "text": "我探过路，周三人少"
  },
  {
   "type": "message",
   "time": "10月9日 21:02",
   "speaker": "A",
   "text": "那周三你去吧，别拉我，减肥"
  },
  {
   "type": "message",
   "time": "10月10日 09:40",
   "speaker": "B",
   "text": "问一句，周四那场兄弟们要不要穿正式点"
  },
  {
   "type": "message",
   "time": "10月10日 09:41",
   "speaker": "A",
   "text": "平常的就行，别太扎眼"
  },
  {
   "type": "message",
   "time": "10月10日 09:41",
   "speaker": "B",
   "text": "手呢，万一呛起来"
  },
  {
   "type": "message",
   "time": "10月10日 09:42",
   "speaker": "A",
   "text": "不许动手，就是站着，听见没"
  },
  {
   "type": "message",
   "time": "10月10日 09:42",
   "speaker": "B",
   "text": "明白，带耳朵不带嘴"
  },
  {
   "type": "message",
   "time": "10月10日 09:43",
   "speaker": "A",
   "text": "对，谈崩了也是我自己的事"
  },
  {
   "type": "message",
   "time": "10月10日 09:43",
   "speaker": "B",
   "text": "你图啥呢，一趟一千"
  },
  {
   "type": "message",
   "time": "10月10日 09:44",
   "speaker": "A",
   "text": "一千买他心里发毛，值"
  },
  {
   "type": "message",
   "time": "10月10日 09:44",
   "speaker": "B",
   "text": "那他当场翻脸走人呢"
  },
  {
   "type": "message",
   "time": "10月10日 09:45",
   "speaker": "A",
   "text": "走不了，茶楼是我挑的，单子我攥着呢"
  },
  {
   "type": "message",
   "time": "10月10日 09:45",
   "speaker": "B",
   "text": "成，兄弟们都听我口令"
  },
  {
   "type": "message",
   "time": "10月10日 09:46",
   "speaker": "A",
   "text": "没口令，全程站着就行"
  },
  {
   "type": "message",
   "time": "10月10日 14:10",
   "speaker": "A",
   "text": "你那车该保养了吧"
  },
  {
   "type": "message",
   "time": "10月10日 14:11",
   "speaker": "B",
   "text": "上礼拜刚做的小保"
  },
  {
   "type": "message",
   "time": "10月10日 14:11",
   "speaker": "A",
   "text": "我那台明早送去，你帮我盯着点"
  },
  {
   "type": "message",
   "time": "10月10日 14:12",
   "speaker": "B",
   "text": "成，师傅我熟，不坑你"
  },
  {
   "type": "message",
   "time": "10月11日 09:15",
   "speaker": "B",
   "text": "人到位了，到茶楼了"
  },
  {
   "type": "message",
   "time": "10月11日 09:16",
   "speaker": "A",
   "text": "好，都别说话，看我手势"
  },
  {
   "type": "message",
   "time": "10月11日 11:50",
   "speaker": "B",
   "text": "散了，老周答应月底先结五万"
  },
  {
   "type": "message",
   "time": "10月11日 11:51",
   "speaker": "A",
   "text": "字据立了没"
  },
  {
   "type": "message",
   "time": "10月11日 11:51",
   "speaker": "B",
   "text": "立了，他签字那手都在抖"
  },
  {
   "type": "message",
   "time": "10月11日 11:52",
   "speaker": "A",
   "text": "一千花得值"
  },
  {
   "type": "message",
   "time": "10月11日 11:52",
   "speaker": "B",
   "text": "兄弟们说下回还找他们"
  },
  {
   "type": "message",
   "time": "10月11日 11:53",
   "speaker": "A",
   "text": "月底见真章再说"
  },
  {
   "type": "message",
   "time": "10月11日 18:20",
   "speaker": "A",
   "text": "晚上烧烤走不走，我请"
  },
  {
   "type": "message",
   "time": "10月11日 18:21",
   "speaker": "B",
   "text": "走，今天兄弟们也辛苦"
  },
  {
   "type": "message",
   "time": "10月11日 18:21",
   "speaker": "A",
   "text": "叫上他们，一桌坐得下不"
  },
  {
   "type": "message",
   "time": "10月11日 18:22",
   "speaker": "B",
   "text": "五个人，挤挤就坐下了"
  },
  {
   "type": "message",
   "time": "10月11日 18:22",
   "speaker": "A",
   "text": "成，七点老地方"
  },
  {
   "type": "message",
   "time": "10月11日 18:23",
   "speaker": "B",
   "text": "见"
  }
 ],
