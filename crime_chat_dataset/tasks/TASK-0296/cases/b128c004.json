   "type": "message",
   "time": "8月3日 12:00",
   "speaker": "B",
   "text": "今天下班你走哪条路？"
  },
  {
   "type": "message",
   "time": "8月3日 12:12",
   "speaker": "A",
   "text": "走河边那条，人少一点。"
  }
