  {
   "type": "message",
   "time": "8月3日 12:12",
   "speaker": "A",
   "text": "我周末试着煮了粥。"
  },
  {
   "type": "message",
   "time": "8月3日 12:24",
   "speaker": "B",
   "text": "咸的还是甜的？"
  },
  {
   "type": "message",
   "time": "8月3日 12:36",
   "speaker": "A",
   "text": "咸的，加了点青菜。"
