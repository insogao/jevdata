  {
   "type": "message",
   "time": "8月3日 10:36",
   "speaker": "B",
   "text": "昨天看还在，停车点没变。"
  },
  {
   "type": "message",
   "time": "8月3日 10:48",
   "speaker": "A",
   "text": "好，我明早骑过去。"
  },
  {
   "type": "message",
   "time": "8月3日 11:00",
   "speaker": "B",
   "text": "记得看下轮胎气够不够。"
