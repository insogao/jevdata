  {
   "type": "message",
   "time": "8月3日 11:12",
   "speaker": "B",
   "text": "天气预报说明天晴。"
  },
  {
   "type": "message",
   "time": "8月3日 11:24",
   "speaker": "A",
   "text": "那我把床单拿去晒晒。"
