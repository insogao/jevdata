{
 "key": "b58c014",
 "archetype_id": "ARC-000087",
 "subtype": "exam_score_lookup",
 "latent_intent": "A试图让学校工作人员向非监护人透露一名学生的成绩，并以红包或熟人关系施加压力；B拒绝查询、发送截图并指向学校正式渠道。对话无学生身份、分数或访问步骤。",
 "critical_facts": [
  "A请求查看并截图一名非其监护学生的成绩。",
  "A提到红包已发或准备发送，并继续索要截图；B拒绝。",
  "B明确指出成绩只能按授权渠道反馈；对话没有学生身份或分数。"
 ],
 "benign_alternatives": [
  "家长查自己孩子",
  "学校官方查询"
 ],
 "events": [
  {
   "type": "message",
   "time": "17月4日 08:00",
   "speaker": "A",
   "text": "你上次问的那位学生，我还是想了解一下。"
  },
  {
   "type": "message",
   "time": "17月4日 08:37",
   "speaker": "A",
   "text": "上次一起吃饭的钱我转给你了。"
  },
  {
   "type": "message",
   "time": "17月4日 09:15",
   "speaker": "B",
   "text": "收到了，是那顿饭的费用。"
  },
  {
   "type": "transfer",
   "time": "17月4日 09:52",
   "from": "A",
   "to": "B",
   "amount": 38,
   "status": "received"
  },
  {
   "type": "message",
   "time": "17月4日 10:30",
   "speaker": "B",
   "text": "我不能向非监护人透露学生成绩。"
  },
  {
   "type": "message",
   "time": "17月4日 11:07",
   "speaker": "A",
   "text": "刚才打印机卡了一下纸。"
  },
  {
   "type": "message",
   "time": "17月4日 11:45",
   "speaker": "A",
   "text": "我跟家长认识，想帮他们问问。"
  },
  {
   "type": "message",
   "time": "17月4日 12:22",
   "speaker": "B",
   "text": "我那边上周也遇到过。"
  },
  {
   "type": "message",
   "time": "17月4日 13:00",
   "speaker": "B",
   "text": "请让家长本人走学校渠道。"
  },
  {
   "type": "message",
   "time": "17月4日 13:37",
   "speaker": "A",
   "text": "好在重新开机就好了。"
  },
  {
   "type": "message",
   "time": "17月4日 14:15",
   "speaker": "A",
   "text": "今天咖啡店人少，排队很快。"
  },
  {
   "type": "message",
   "time": "17月4日 14:52",
   "speaker": "B",
   "text": "那就行。"
  },
  {
   "type": "message",
   "time": "17月4日 15:30",
   "speaker": "B",
   "text": "可能大家都还没到午休时间。"
  },
  {
   "type": "message",
   "time": "17月4日 16:07",
   "speaker": "A",
   "text": "我想周末把厨房收拾一下。"
  },
  {
   "type": "message",
   "time": "17月4日 16:45",
   "speaker": "A",
   "text": "我顺便买了个面包。"
  },
  {
   "type": "message",
   "time": "17月4日 17:22",
   "speaker": "B",
   "text": "从台面开始会比较快。"
  },
  {
   "type": "message",
   "time": "17月4日 18:00",
   "speaker": "B",
   "text": "当下午茶刚好。"
  },
  {
   "type": "message",
   "time": "17月4日 18:37",
   "speaker": "A",
   "text": "好，先把不用的东西收起来。"
  },
  {
   "type": "message",
   "time": "17月4日 19:15",
   "speaker": "A",
   "text": "班主任那边看一下，截个图给我就行。"
  },
  {
   "type": "message",
   "time": "17月4日 19:52",
   "speaker": "B",
   "text": "慢慢弄，不用一次做完。"
  },
  {
   "type": "message",
   "time": "17月4日 20:30",
   "speaker": "B",
   "text": "我不会私下查看或发送截图。"
  },
  {
   "type": "message",
   "time": "17月4日 21:07",
   "speaker": "A",
   "text": "今天下午有点犯困。"
  },
  {
