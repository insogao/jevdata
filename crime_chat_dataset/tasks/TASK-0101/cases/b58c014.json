   "type": "message",
   "time": "17月5日 18:37",
   "speaker": "A",
   "text": "去过两次，汤面味道还行。"
  },
  {
   "type": "message",
   "time": "17月5日 19:15",
   "speaker": "B",
   "text": "闻着就挺香。"
  },
  {
   "type": "message",
   "time": "17月5日 19:52",
   "speaker": "B",
   "text": "我还没试过，下次点个不辣的。"
