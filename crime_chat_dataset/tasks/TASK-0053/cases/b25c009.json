{
 "key": "b25c009",
 "archetype_id": "ARC-000108",
 "subtype": "key_copy_burglary",
 "latent_intent": "团伙头目踩点老小区独住户，指使手下锁匠趁傍晚家中无人进屋取财，约定只做一次，当晚交接并转账酬金，全程用「跑一趟」「东西」代替实指。",
 "critical_facts": [
  "选定九十年代老小区、单元门损坏的楼栋",
  "约定傍晚五点半家中无人时进去，只做一次不做第二回",
  "取出的「东西」当晚在老码头停车场交接",
  "酬金4500元转账与「说好的数」对应"
 ],
 "benign_alternatives": [
  "正规开锁换锁服务",
  "物业钥匙托管与巡查"
 ],
 "events": [
  {
   "type": "message",
   "time": "10月13日 11:20",
   "speaker": "A",
   "text": "周五下午给我跑一趟，有空没"
  },
  {
   "type": "message",
   "time": "10月13日 11:23",
   "speaker": "B",
   "text": "哪一趟"
  },
  {
   "type": "message",
   "time": "10月13日 11:25",
   "speaker": "A",
   "text": "河东那片，你上回说最好对付的那种老小区，九十年代的房子"
  },
  {
   "type": "message",
   "time": "10月13日 11:27",
   "speaker": "B",
   "text": "恩，那种对付过几个，不费劲"
  },
  {
   "type": "message",
   "time": "10月13日 11:28",
   "speaker": "A",
   "text": "我看中一栋，六楼东户，那家人作息我让人看了几天"
  },
  {
   "type": "message",
   "time": "10月13日 11:31",
   "speaker": "A",
   "text": "傍晚五点半，家里基本没人，就一趟，去一回就收，不做第二回"
  },
  {
   "type": "message",
   "time": "10月13日 11:33",
   "speaker": "B",
   "text": "明白，你的规矩"
  },
  {
   "type": "message",
   "time": "10月13日 11:35",
   "speaker": "A",
   "text": "家伙什自己带还是我给你备"
  },
  {
   "type": "message",
   "time": "10月13日 11:36",
   "speaker": "B",
   "text": "我有，老一套"
  },
  {
   "type": "message",
   "time": "10月13日 12:02",
   "speaker": "A",
   "text": "中午吃的啥"
  },
  {
   "type": "message",
   "time": "10月13日 12:05",
   "speaker": "B",
   "text": "楼下牛肉面，老位置"
  },
  {
   "type": "message",
   "time": "10月13日 12:06",
   "speaker": "A",
   "text": "你天天面，胃行吗"
  },
  {
   "type": "message",
   "time": "10月13日 12:08",
   "speaker": "B",
   "text": "加了个蛋，营养均衡"
  },
  {
   "type": "message",
   "time": "10月13日 12:09",
   "speaker": "A",
   "text": "少喝点酒，你那腰还得用"
  },
  {
   "type": "message",
   "time": "10月13日 12:11",
   "speaker": "B",
   "text": "提醒了，贴着膏药呢"
  },
  {
   "type": "message",
   "time": "10月14日 15:10",
   "speaker": "B",
   "text": "你说那栋我路过看了眼，单元门是坏的"
  },
  {
   "type": "message",
   "time": "10月14日 15:12",
   "speaker": "A",
   "text": "我就知道省事，楼道里杂物多不"
  },
  {
   "type": "message",
   "time": "10月14日 15:14",
   "speaker": "B",
   "text": "多，五楼堆了一楼道纸箱"
  },
  {
   "type": "message",
   "time": "10月14日 15:15",
   "speaker": "A",
   "text": "周五你四点半到，先在小区外转一圈再进"
  },
  {
   "type": "message",
   "time": "10月14日 15:17",
   "speaker": "B",
   "text": "恩，走哪个门"
  },
  {
   "type": "message",
   "time": "10月14日 15:18",
   "speaker": "A",
   "text": "北门，离那单元近，出来也走北门"
  },
  {
   "type": "message",
   "time": "10月14日 15:20",
   "speaker": "B",
   "text": "记下了"
  },
  {
   "type": "message",
   "time": "10月14日 19:30",
   "speaker": "A",
   "text": "降温了，你那屋暖气烧了没"
  },
  {
   "type": "message",
   "time": "10月14日 19:33",
   "speaker": "B",
   "text": "烧了，就是干，嗓子疼"
  },
  {
   "type": "message",
   "time": "10月14日 19:34",
   "speaker": "A",
   "text": "加湿器安排上"
  },
  {
   "type": "message",
   "time": "10月14日 19:36",
   "speaker": "B",
   "text": "我姐寄了一个，还没到"
  },
  {
   "type": "message",
   "time": "10月14日 19:37",
   "speaker": "A",
   "text": "到了就用上，晚上吃好点"
  },
  {
   "type": "message",
   "time": "10月14日 19:40",
   "speaker": "B",
   "text": "晚上在我姐家蹭的饭，她做了鲈鱼"
  },
  {
   "type": "message",
   "time": "10月14日 19:42",
   "speaker": "A",
   "text": "清蒸的？"
  },
  {
   "type": "message",
   "time": "10月14日 19:43",
   "speaker": "B",
   "text": "恩，我姐手艺可以"
  },
  {
   "type": "message",
   "time": "10月14日 19:45",
   "speaker": "A",
   "text": "下回叫上你姐夫，钓鱼那事他还欠着"
  },
  {
   "type": "message",
   "time": "10月14日 19:46",
   "speaker": "B",
   "text": "他就是忙，别催他"
  },
  {
   "type": "message",
   "time": "10月15日 10:15",
   "speaker": "A",
   "text": "周五那趟时间掐准，傍晚五点半，前后别差太多"
  },
  {
   "type": "message",
   "time": "10月15日 10:18",
   "speaker": "B",
   "text": "五点半楼里人最少吧"
  },
  {
   "type": "message",
   "time": "10月15日 10:20",
   "speaker": "A",
   "text": "正是下班路上，屋里剩不了两户，进去二十分钟内出来"
  },
  {
   "type": "message",
   "time": "10月15日 10:22",
   "speaker": "B",
   "text": "行，不磨蹭"
  },
  {
   "type": "message",
   "time": "10月15日 10:23",
   "speaker": "A",
   "text": "做完这边的事就结了，你不用再管"
  },
  {
   "type": "message",
   "time": "10月15日 14:40",
   "speaker": "B",
   "text": "我儿子补习班又催缴费，一学期八千多"
  },
  {
   "type": "message",
   "time": "10月15日 14:42",
   "speaker": "A",
   "text": "现在都这么贵"
  },
  {
   "type": "message",
   "time": "10月15日 14:43",
   "speaker": "B",
   "text": "不敢停，别的孩子都在上"
  },
  {
   "type": "message",
   "time": "10月15日 14:45",
   "speaker": "A",
   "text": "他成绩咋样"
  },
  {
   "type": "message",
   "time": "10月15日 14:46",
   "speaker": "B",
   "text": "数学还行，语文拖后腿"
  },
  {
   "type": "message",
   "time": "10月15日 14:48",
   "speaker": "A",
   "text": "慢慢来，周五完事你手头也宽裕点"
  },
  {
   "type": "message",
   "time": "10月16日 16:05",
   "speaker": "B",
   "text": "明天四点半到北门，家伙什带齐了"
  },
  {
   "type": "message",
   "time": "10月16日 16:08",
   "speaker": "A",
   "text": "别穿工装，背个双肩包，别迟到"
  },
  {
   "type": "message",
   "time": "10月16日 16:09",
   "speaker": "B",
   "text": "收到"
  },
  {
   "type": "message",
   "time": "10月16日 16:10",
   "speaker": "A",
   "text": "完事直接回家，当天别接别的活"
  },
  {
   "type": "message",
   "time": "10月16日 16:12",
   "speaker": "B",
   "text": "知道，误事"
  },
  {
   "type": "message",
   "time": "10月16日 16:14",
   "speaker": "B",
   "text": "顺路加个油，油价又涨了"
  },
  {
   "type": "message",
   "time": "10月16日 16:16",
   "speaker": "A",
   "text": "可不，一箱多花三十"
  },
  {
   "type": "message",
   "time": "10月16日 16:17",
   "speaker": "B",
   "text": "你那车该保养了吧"
  },
  {
   "type": "message",
   "time": "10月16日 16:19",
   "speaker": "A",
   "text": "下周去，正好跑趟高速"
  },
  {
   "type": "message",
   "time": "10月17日 18:50",
   "speaker": "B",
   "text": "出来了，东西在我车上"
  },
  {
   "type": "message",
   "time": "10月17日 18:53",
   "speaker": "A",
   "text": "别开箱，直接放我这，晚上八点老码头停车场，我给你结"
  },
  {
   "type": "message",
   "time": "10月17日 18:55",
   "speaker": "B",
   "text": "好"
  },
  {
   "type": "message",
   "time": "10月17日 20:06",
   "speaker": "A",
   "text": "到哪了"
  },
  {
   "type": "message",
   "time": "10月17日 20:06",
   "speaker": "B",
   "text": "停好了，过来"
  },
  {
   "type": "transfer",
   "time": "10月17日 20:08",
   "from": "A",
   "to": "B",
   "amount": 4500
  },
  {
   "type": "message",
   "time": "10月17日 20:09",
   "speaker": "A",
   "text": "点下，说好的数"
  },
  {
   "type": "message",
   "time": "10月17日 20:11",
   "speaker": "B",
   "text": "收到，正好给儿子交补习费"
  },
  {
   "type": "message",
   "time": "10月17日 20:13",
   "speaker": "A",
   "text": "这页翻篇，最近少联系，过了这阵再走动"
  },
  {
   "type": "message",
   "time": "10月17日 20:14",
   "speaker": "B",
   "text": "恩，懂的"
  }
 ],
