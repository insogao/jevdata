  {
   "type": "message",
   "time": "9月8日 09:33",
   "speaker": "B",
   "text": "那不等一年？"
  },
  {
   "type": "message",
   "time": "9月8日 09:36",
   "speaker": "A",
   "text": "等一年再看，名额早没了"
