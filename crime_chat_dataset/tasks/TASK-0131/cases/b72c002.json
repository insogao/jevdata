 "events": [
  {
   "type": "message",
   "time": "10月8日 09:00",
   "speaker": "A",
   "text": "我替人问问，能不能看看另一个学生的成绩档案？"
  },
  {
   "type": "message",
   "time": "10月8日 09:04",
   "speaker": "B",
   "text": "你不是监护人，我不能打开那份记录。"
