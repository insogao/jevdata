  {
   "type": "message",
   "time": "10月28日 20:31",
   "speaker": "A",
   "text": "知道，都听他的"
  },
  {
   "type": "message",
   "time": "10月29日 09:10",
   "speaker": "A",
   "text": "昨晚看球坐太久，腰直不起来"
