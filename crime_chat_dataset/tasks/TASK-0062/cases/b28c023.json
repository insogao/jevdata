  {
   "type": "message",
   "time": "10月29日 09:30",
   "speaker": "B",
   "text": "我一周两游，服不服"
  },
  {
   "type": "message",
   "time": "10月29日 11:20",
   "speaker": "A",
   "text": "瓶子样拍好了，你看这个瓶型"
